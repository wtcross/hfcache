{
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "allowJs": true,
        "checkJs": true,
        "exactOptionalPropertyTypes": true,
        "noUncheckedSideEffectImports": false,
        "jsx": "react",
        "lib": ["dom", "es2020"],
        "paths": { "superuser": ["./src/superuser.d.ts"], "*": ["./pkg/lib/*"] },
        "moduleResolution": "bundler",
        "noEmit": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "es2020",
        "types": ["node"]
    },
    "include": ["src/**/*", "test/**/*"]
}
