[Unit]
Description=hfcache rootless API and online executor
Wants=hfcache-verification.socket
After=hfcache-verification.socket hfcache-verification.service
PartOf=hfcache.target

[Service]
Type=exec
ExecStart=/usr/local/libexec/hfcache-container-service api
ExecStop=/usr/local/libexec/hfcache-container-service stop api
TimeoutStartSec=300
TimeoutStopSec=infinity
SendSIGKILL=no
MemoryHigh=4G
UMask=0077
UnsetEnvironment=LISTEN_PIDFDID HF_TOKEN HUGGING_FACE_HUB_TOKEN HUGGINGFACE_HUB_TOKEN HUGGINGFACEHUB_API_TOKEN CREDENTIALS_DIRECTORY HF_TOKEN_PATH HFCACHE_API_TOKEN HFCACHE_MCP_TOKEN
