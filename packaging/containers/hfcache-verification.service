[Unit]
Description=hfcache rootless credential-free offline verifier
PartOf=hfcache.target

[Service]
Type=notify
NotifyAccess=all
ExecStart=/usr/local/libexec/hfcache-container-service worker
ExecStop=/usr/local/libexec/hfcache-container-service stop worker
TimeoutStartSec=300
TimeoutStopSec=infinity
SendSIGKILL=no
MemoryHigh=4G
UMask=0077
UnsetEnvironment=LISTEN_PIDFDID HF_TOKEN HUGGING_FACE_HUB_TOKEN HUGGINGFACE_HUB_TOKEN HUGGINGFACEHUB_API_TOKEN CREDENTIALS_DIRECTORY HF_TOKEN_PATH HFCACHE_API_TOKEN HFCACHE_MCP_TOKEN
