# API-backed observer; retained private state never authorizes replay (ADR121).
[Unit]
Description=Observe synchronization of configured repositories
Documentation=file:///opt/hfcache/current/docs/operations.md
Requires=hfcache-api.socket
After=hfcache-api.socket
PartOf=hfcache.target
#OnFailure=hfcache-failure@%n.service

[Service]
Type=oneshot
User=hfcache
Group=hfcache
UMask=0077
ExecStart=/opt/hfcache/current/.venv/bin/python -m hfcache.scheduled_client --client-config /etc/hfcache/scheduled-client.toml --state-directory /var/lib/hfcache/scheduled/sync sync
# Multiple finite HTTP windows preserve the original unlimited oneshot lifetime.
TimeoutStartSec=infinity
# Client shutdown leaves its handle and never proves execution stopped.
TimeoutStopSec=30
StateDirectory=hfcache/scheduled/sync
StateDirectoryMode=0700
RuntimeDirectory=hfcache
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
LoadCredentialEncrypted=hfcache.api:/etc/credstore.encrypted/hfcache.api
UnsetEnvironment=HF_TOKEN HUGGING_FACE_HUB_TOKEN HUGGINGFACE_HUB_TOKEN HUGGINGFACEHUB_API_TOKEN HF_TOKEN_PATH HFCACHE_API_TOKEN HFCACHE_MCP_TOKEN
# No archive access or Hub state is needed by an HTTP observer.
InaccessiblePaths=-/srv/hfcache -/var/lib/hfcache/hf-home
IPAddressDeny=any
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX

[Install]
# Timers retain their existing names/calendars; verify stays disabled by default.
