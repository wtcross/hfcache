# Migration-only reset for legacy native scheduled-client Hub imports.
# Do not install during ordinary provisioning: the packaged native client already
# loads its separate encrypted hfcache.api credential. Review any installed legacy
# ImportCredential=hf-token and remove that Hub authority in a maintenance window.
# Hub hf-token belongs only to hfcache-api.service. Rootless roles use their own
# fixed Podman file sources; this example does not configure them.
[Service]
ImportCredential=
