# Supply a Hub token as an encrypted systemd credential (plan §22.6, AD-21).
#
# **Not installed by default.** A deployment without a token archives public
# repositories anonymously: `hub.token_mode = "optional"` with no credential
# present, and every Hub call passes `token=False` explicitly rather than
# `None` (docs/security.md T-07). For private or gated repositories set
# `hub.token_mode = "required"`; that mode refuses with `HFARG008` unless this
# credential resolves, and it is the explicit authorization-scope opt-in. This
# file exists so that adding a token is a documented, tested step rather than an
# improvisation.
#
# Install as:
#
#     /etc/systemd/system/hfcache-sync.service.d/credential.conf
#
# after creating the encrypted credential. Drop the `.example` suffix; systemd
# only reads `*.conf`.
#
# ---------------------------------------------------------------------------
# Creating the credential
# ---------------------------------------------------------------------------
#
# `systemd-creds encrypt` binds the ciphertext to this host — to the TPM where
# one is available, otherwise to /var/lib/systemd/credential.secret — and to
# the credential name given by --name. systemd refuses to decrypt a credential
# into a name other than the embedded one, so a swapped file fails loudly
# rather than silently passing the wrong secret; and because the binding is to
# host and name rather than to one unit, every unit that states
# `ImportCredential=hf-token` receives the same credential — the scheduled
# sync below, and the transient units the Cockpit plugin spawns
# (docs/cockpit.md §2). The plaintext never exists on disk at all.
#
# The credential lives in systemd's system credential store, which is where
# `ImportCredential=` searches:
#
#     umask 077
#     mkdir -p /etc/credstore.encrypted
#     printf '%s' 'hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx' > /root/hf-token
#     systemd-creds encrypt --name=hf-token /root/hf-token \
#         /etc/credstore.encrypted/hf-token
#     shred -u /root/hf-token
#
# The `--name` and the filename under /etc/credstore.encrypted must both match
# `hub.credential_name` in /etc/hfcache/config.toml, because that is the
# filename the application looks for under $CREDENTIALS_DIRECTORY. The Cockpit
# plugin imports the default name `hf-token` specifically; a deployment that
# renames the credential keeps a working scheduled sync (edit the drop-in to
# match) but runs anonymously from the plugin, and `doctor`'s `credential` and
# `hub_identity` rows report exactly that.
#
# ---------------------------------------------------------------------------
# What the application does with it
# ---------------------------------------------------------------------------
#
# It reads $CREDENTIALS_DIRECTORY/<hub.credential_name> and nothing else: no
# home-directory token discovery, no ambient HF_TOKEN or HUGGING_FACE_HUB_TOKEN
# (docs/configuration.md §7). The secret is never written to the archive, never
# written back to the TOML, and never logged — it is reported by shape, never by
# content. Set `hub.expected_account` at the same time and `doctor` will verify
# the credential belongs to the account you think it does, which is what catches
# a token swapped by mistake before a scheduled run uses it. Every consumer of
# the publication export must be authorized to receive every private/gated
# repository this credential can archive; there are no per-repository ACLs.
#
# Acceptance after installing:
#
#     systemctl daemon-reload
#     systemd-analyze verify hfcache-sync.service
#     systemd-run --quiet --wait --pipe --collect \
#         -p User=hfcache -p Group=hfcache -p ImportCredential=hf-token \
#         -E HF_HOME=/var/lib/hfcache/hf-home \
#         -E HF_XET_CACHE=/var/cache/hfcache/xet \
#         -- /opt/hfcache/current/.venv/bin/hfcache doctor --read-only
#     # `credential` row: token from systemd-credential; `hub_identity`
#     # row: the configured expected_account
#     systemctl start hfcache-sync.service
#     journalctl -u hfcache-sync.service | grep -c hf_    # must be 0
#
# A plain `sudo -u hfcache hfcache doctor` runs anonymously by design — no
# systemd unit, no credential — and with `expected_account` set its
# `hub_identity` check reports exactly that. Use the systemd-run shape above,
# which is also the shape the Cockpit plugin uses. Run it in a terminal or
# pipe the output — redirecting stdout to a file hands PID 1 a file
# descriptor SELinux rightly refuses, which surfaces as `Remote peer
# disconnected`.

[Service]
ImportCredential=hf-token
