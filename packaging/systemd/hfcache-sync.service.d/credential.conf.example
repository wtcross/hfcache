# Optional: supply a Hub token as an encrypted systemd credential (plan §22.6).
#
# **Not installed by default, and not needed by this deployment.** The initial
# rollout archives public repositories anonymously: `hub.token_mode = "optional"`
# with no credential present, and every Hub call passes `token=False` explicitly
# rather than `None` (docs/security.md T-07). This file exists so that adding a
# token later is a documented, tested step rather than an improvisation.
#
# Install as:
#
#     /etc/systemd/system/hfcache-sync.service.d/credential.conf
#
# after creating the encrypted credential. Drop the `.example` suffix; systemd
# only reads `*.conf`.
#
# ---------------------------------------------------------------------------
# Creating the credential
# ---------------------------------------------------------------------------
#
# `systemd-creds encrypt` binds the ciphertext to this host — to the TPM where one
# is available, otherwise to /var/lib/systemd/credential.secret — and to the unit
# name given by --name. A credential encrypted for one unit cannot be read by
# another, which is the property that makes this better than a mode-0600 file:
# the plaintext never exists on disk at all.
#
#     umask 077
#     printf '%s' 'hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx' > /root/hf-token
#     systemd-creds encrypt --name=hf-token /root/hf-token \
#         /etc/hfcache/hf-token.cred
#     shred -u /root/hf-token
#     chown root:root /etc/hfcache/hf-token.cred
#     chmod 0600 /etc/hfcache/hf-token.cred
#
# The `--name` must match `hub.credential_name` in /etc/hfcache/config.toml,
# because that is the filename the application looks for under
# $CREDENTIALS_DIRECTORY. systemd refuses to load a credential whose embedded
# name does not match the one requested, so a mismatch fails the unit rather
# than silently passing the wrong secret.
#
# ---------------------------------------------------------------------------
# What the application does with it
# ---------------------------------------------------------------------------
#
# It reads $CREDENTIALS_DIRECTORY/<hub.credential_name> and nothing else: no
# home-directory token discovery, no ambient HF_TOKEN or HUGGING_FACE_HUB_TOKEN
# (docs/configuration.md §7). The secret is never written to the archive, never
# written back to the TOML, and never logged — it is reported by shape, never by
# content. Set `hub.expected_account` at the same time and `doctor` will verify
# the credential belongs to the account you think it does, which is what catches
# a token swapped by mistake before a scheduled run uses it.
#
# Acceptance after installing:
#
#     systemctl daemon-reload
#     systemd-analyze verify hfcache-sync.service
#     sudo -u hfcache /opt/hfcache/current/.venv/bin/hfcache doctor   # `credential` row
#     systemctl start hfcache-sync.service
#     journalctl -u hfcache-sync.service | grep -c hf_    # must be 0

[Service]
LoadCredentialEncrypted=hf-token:/etc/hfcache/hf-token.cred
