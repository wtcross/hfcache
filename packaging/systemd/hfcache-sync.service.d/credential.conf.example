# API-014 migration: scheduled clients never import the Hub credential.
# This historical example is retained so old deployments do not reuse it silently.
# Remove any installed `ImportCredential=hf-token` from this client service.
# The packaged service already imports hfcache.api using LoadCredentialEncrypted.
# Hub hf-token belongs only to hfcache-api.service (ADR121).
[Service]
ImportCredential=
