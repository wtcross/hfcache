(allow hfcache_host_helper_t unconfined_t (dbus (send_msg)))
; Stock role-specific service-account session broker; fixed metadata transport only.
(allow hfcache_host_helper_t unconfined_dbusd_t (unix_stream_socket (connectto)))
(allow hfcache_host_helper_t unconfined_dbusd_t (dbus (send_msg)))
(allow hfcache_host_helper_t system_dbusd_t (unix_stream_socket (connectto)))
(allow hfcache_host_helper_t system_dbusd_t (dbus (send_msg)))
(allow hfcache_host_helper_t init_t (unix_dgram_socket (sendto)))
; The measured fixed manager notify socket carries the kernel_t SID.
(allow hfcache_host_helper_t kernel_t (unix_dgram_socket (sendto)))
(allow hfcache_host_helper_t var_run_t (sock_file (getattr read write)))
(allow hfcache_host_helper_t container_var_run_t (sock_file (getattr read write)))

; Optional native sync-observer profile. Only the separately provisioned,
; indexed fixed service fragment requests this context. There is no automatic
; transition on the shared interpreter and no unconfined-domain attribute.
(allow init_t hfcache_sync_observer_t (process (transition)))
(allow init_t hfcache_sync_observer_t (process2 (nnp_transition)))
(allow hfcache_sync_observer_t bin_t (file (entrypoint getattr open read map execute)))
(allow hfcache_sync_observer_t self (process (getattr getcap getsched sigchld)))
(allow hfcache_sync_observer_t init_t (process (sigchld)))
(allow hfcache_sync_observer_t init_t (fd (use)))
(allow hfcache_sync_observer_t init_t (unix_stream_socket (getattr read write getopt setopt shutdown)))
; The measured native Unix API listener has unconfined_service_t peer context.
(allow hfcache_sync_observer_t unconfined_service_t (unix_stream_socket (connectto)))
(allow hfcache_sync_observer_t self (unix_stream_socket (create connect getattr read write getopt setopt shutdown)))
(allow hfcache_sync_observer_t self (fifo_file (getattr read write ioctl)))
(allow hfcache_sync_observer_t null_device_t (chr_file (getattr open read write)))
; Read-only Python/native-extension/locale/trust-store dependencies.
(allow hfcache_sync_observer_t root_t (dir (getattr search open read)))
(allow hfcache_sync_observer_t usr_t (dir (getattr search open read)))
(allow hfcache_sync_observer_t usr_t (file (getattr open read map execute)))
(allow hfcache_sync_observer_t usr_t (lnk_file (getattr read)))
(allow hfcache_sync_observer_t bin_t (dir (getattr search open read)))
(allow hfcache_sync_observer_t bin_t (lnk_file (getattr read)))
(allow hfcache_sync_observer_t lib_t (dir (getattr search open read)))
(allow hfcache_sync_observer_t lib_t (file (getattr open read map execute)))
(allow hfcache_sync_observer_t lib_t (lnk_file (getattr read)))
(allow hfcache_sync_observer_t ld_so_t (file (getattr open read map execute)))
(allow hfcache_sync_observer_t ld_so_cache_t (file (getattr open read map)))
(allow hfcache_sync_observer_t etc_t (dir (getattr search open read)))
(allow hfcache_sync_observer_t etc_t (file (getattr open read map)))
(allow hfcache_sync_observer_t etc_t (lnk_file (getattr read)))
(allow hfcache_sync_observer_t passwd_file_t (file (getattr open read)))
(allow hfcache_sync_observer_t locale_t (dir (getattr search open read)))
(allow hfcache_sync_observer_t locale_t (file (getattr open read map)))
(allow hfcache_sync_observer_t cert_t (dir (getattr search open read)))
(allow hfcache_sync_observer_t cert_t (file (getattr open read map)))
(allow hfcache_sync_observer_t cert_t (lnk_file (getattr read)))
; Fixed client configuration is read-only; source credentials remain denied.
(allow hfcache_sync_observer_t hfcache_host_helper_configuration_dir_t (dir (getattr search open read)))
(allow hfcache_sync_observer_t hfcache_host_helper_conf_t (file (getattr open read)))
(allow hfcache_sync_observer_t var_t (dir (getattr search open read)))
(allow hfcache_sync_observer_t var_lib_t (dir (getattr search open read)))
; Measured native scheduled-state ancestor, read-only descriptor traversal.
(allow hfcache_sync_observer_t init_var_lib_t (dir (getattr search open read)))
; The actual fixed Unix API socket uses this runtime type. The indexed unit
; forbids IP and makes only its dedicated SDK state writable.
(allow hfcache_sync_observer_t var_run_t (dir (getattr search open read)))
(allow hfcache_sync_observer_t var_run_t (sock_file (getattr write)))
; Actual systemd-delivered hfcache.api credential: init_var_run_t, readonly.
(allow hfcache_sync_observer_t init_var_run_t (dir (getattr search open read)))
(allow hfcache_sync_observer_t init_var_run_t (file (getattr open read)))
(allow hfcache_sync_observer_t hfcache_sync_observer_state_t (dir (getattr search open read write add_name remove_name create setattr)))
(allow hfcache_sync_observer_t hfcache_sync_observer_state_t (file (getattr open read write create setattr rename unlink lock)))
(typetransition hfcache_sync_observer_t hfcache_sync_observer_state_t file hfcache_sync_observer_state_t)
; Manager provisioning/chown metadata only; no manager read of SDK handles.
(allow init_t hfcache_sync_observer_state_t (dir (getattr search open read setattr mounton)))
(allow init_t hfcache_sync_observer_state_t (file (getattr setattr)))
(neverallow hfcache_sync_observer_t self (capability (chown dac_override dac_read_search fowner fsetid kill setgid setuid setpcap net_bind_service net_admin net_raw sys_chroot sys_ptrace sys_admin)))
(neverallow hfcache_sync_observer_t domain (process (transition dyntransition setexec)))
(neverallow hfcache_sync_observer_t shell_exec_t (file (execute execute_no_trans entrypoint)))
(neverallow hfcache_sync_observer_t self (tcp_socket (create)))
(neverallow hfcache_sync_observer_t self (udp_socket (create)))
(neverallow hfcache_sync_observer_t self (rawip_socket (create)))
(neverallow hfcache_sync_observer_t nfs_t (file (getattr open read write map execute)))
(neverallow hfcache_sync_observer_t hfcache_archive_t (file (getattr open read write map execute)))
(neverallow hfcache_sync_observer_t hfcache_host_helper_secret_t (file (getattr open read write map execute)))
(neverallow hfcache_sync_observer_t hfcache_host_helper_hub_state_t (file (getattr open read write map execute)))
(neverallow hfcache_sync_observer_t hfcache_host_helper_host_action_state_t (file (getattr open read write map execute)))
(neverallow hfcache_sync_observer_t hfcache_host_helper_application_state_t (file (getattr open read write map execute)))
(neverallow hfcache_sync_observer_t hfcache_host_helper_configuration_guard_t (file (getattr open read write map execute)))

; Fixed shared config is read-only; mutable Hub state stays helper-denied.
(allow container_t hfcache_host_helper_configuration_dir_t (dir (getattr search open read)))
(allow container_t hfcache_host_helper_application_conf_t (file (getattr open read)))
(allow container_t hfcache_host_helper_hub_state_t (dir (getattr search open read write add_name remove_name create setattr rmdir)))
(allow container_t hfcache_host_helper_hub_state_t (file (getattr open read write append create setattr unlink rename link lock map)))
(allow container_t hfcache_host_helper_hub_state_t (lnk_file (getattr read create setattr unlink rename)))

; Existing container roles need only their legitimate read-only mounted inputs.
; This never adds helper access and does not select or create a mount.
(allow container_t hfcache_archive_t (dir (getattr search open read)))
(allow container_t hfcache_archive_t (file (getattr open read map)))
(allow container_t hfcache_host_helper_secret_t (dir (getattr search)))
(allow container_t hfcache_host_helper_secret_t (file (getattr open read map)))
(allow container_t hfcache_host_helper_runtime_t (dir (getattr search)))
(allow container_t hfcache_host_helper_runtime_t (file (getattr open read)))
(allow container_t hfcache_host_helper_runtime_t (sock_file (getattr open read write)))
(allow container_t hfcache_host_helper_t (unix_stream_socket (connectto)))

; A merged policy granting these would fail validation, not silently weaken.
(neverallow hfcache_host_helper_t hfcache_archive_t (file (read open map execute)))
(neverallow hfcache_host_helper_t nfs_t (file (read open map execute)))
(neverallow hfcache_host_helper_t hfcache_host_helper_secret_t (file (read open map execute)))
(neverallow hfcache_host_helper_t hfcache_host_helper_hub_state_t (file (read open map execute)))
(neverallow hfcache_host_helper_t domain (process (transition dyntransition setexec)))
(neverallow hfcache_host_helper_t domain (process (ptrace)))
(neverallow hfcache_host_helper_t self (capability (sys_admin sys_ptrace dac_override dac_read_search setpcap sys_module sys_rawio)))
(neverallow hfcache_host_helper_t security_t (security (load_policy setenforce setbool)))

; Image payloads and image directories must remain immutable to the helper.
(neverallow hfcache_host_helper_t container_ro_file_t (file (write append create setattr unlink rename link)))
(neverallow hfcache_host_helper_t container_ro_file_t (dir (write add_name remove_name create setattr rmdir rename)))
; Lock labels grant coordination only, never replacement, creation or execution.
(neverallow hfcache_host_helper_t hfcache_host_helper_engine_lock_t (file (append create setattr unlink rename link map execute)))
; Archive-lock observation must never acquire content, lock or relabel authority.
(neverallow hfcache_host_helper_t hfcache_host_helper_archive_lock_t (file (ioctl open read write append create setattr lock relabelfrom relabelto unlink link rename map execute execute_no_trans entrypoint mounton)))
