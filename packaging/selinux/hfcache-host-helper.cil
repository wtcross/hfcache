; Fixed system-manager metadata only; no manager control rights.
(allow hfcache_host_helper_t init_t (system (status)))
(allow hfcache_host_helper_t systemd_unit_file_t (service (status)))
; Fixed argv and v2 live-label proof constrain these type-level manager rights.
; No generic-unit start/stop, enable/disable or API/worker/target operation.
(allow hfcache_host_helper_t init_t (system (reload)))
(allow hfcache_host_helper_t hfcache_host_helper_sync_timer_unit_t (service (status start stop)))
; A same-UID child signals only the retained original native observer pidfd.
; SIGTERM maps to signal; no other-domain SIGKILL or CAP_KILL is granted.
(allow hfcache_host_helper_t hfcache_sync_observer_t (process (getattr signal)))
(allow hfcache_host_helper_t hfcache_sync_observer_t (file (getattr open read)))
(allow hfcache_host_helper_t hfcache_sync_observer_t (dir (getattr search open read)))
(allow hfcache_host_helper_t hfcache_sync_observer_t (lnk_file (getattr read)))
; SDK-state proof observes only the directory's inode/SID, never its handles.
(allow hfcache_host_helper_t hfcache_sync_observer_state_t (dir (getattr)))
; Actual volatile journal types and persistent journal's standard log type.
; These rights are read-only and type-wide; fixed journalctl sources project
; only closed event/level/run-ID fields, never arbitrary MESSAGE prose.
(allow hfcache_host_helper_t syslogd_var_run_t (dir (getattr search open read)))
(allow hfcache_host_helper_t syslogd_var_run_t (file (getattr open read map)))
(allow hfcache_host_helper_t var_log_t (dir (getattr search open read)))
(allow hfcache_host_helper_t var_log_t (file (getattr open read map)))
