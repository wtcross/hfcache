{
  "name": "hfcache-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "(MIT AND LGPL-2.1-or-later)",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "24.18.1",
    "pnpm": "11.18.0"
  },
  "scripts": {
    "generate:wire": "node scripts/generate-wire.ts --write",
    "check:wire": "node scripts/generate-wire.ts --check",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test:strict-fixtures": "node scripts/check-strict-fixtures.ts",
    "test:auth-sandbox": "node scripts/check-auth-sandbox-tests.ts",
    "test:functional-metadata": "node scripts/check-functional-driver-tests.ts",
    "test:unit": "node scripts/test-suite.ts unit",
    "test:component": "node scripts/test-suite.ts component",
    "build": "node scripts/build-artifact.ts",
    "test:browser": "node scripts/browser-smoke.ts",
    "test:library-zoom": "node scripts/check-library-zoom.ts",
    "licenses": "node scripts/licenses.ts"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.13.3",
    "@types/react": "18.3.13",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
